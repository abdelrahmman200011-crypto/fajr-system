rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isBranchUser() {
      return isSignedIn() && (
        request.auth.token.role == 'branch' ||
        request.auth.token.role == 'admin'
      );
    }

    function sameBranch(data) {
      return isSignedIn() &&
        request.auth.token.branch == data.branch;
    }

    function branchAllowed(resourceData) {
      return isBranchUser() && (
        isAdmin() ||
        (resourceData != null && request.auth.token.branch == resourceData.branch)
      );
    }

    match /passengers/{docId} {
      allow read: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch);
      allow create: if isAdmin() || (isBranchUser() && request.resource.data.branch == request.auth.token.branch);
      allow update: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch && request.resource.data.branch == request.auth.token.branch);
      allow delete: if isAdmin();
    }

    match /trips/{docId} {
      allow read: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch);
      allow create: if isAdmin() || (isBranchUser() && request.resource.data.branch == request.auth.token.branch);
      allow update: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch && request.resource.data.branch == request.auth.token.branch);
      allow delete: if isAdmin();
    }

    match /invoices/{docId} {
      allow read: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch);
      allow create: if isAdmin() || (isBranchUser() && request.resource.data.branch == request.auth.token.branch);
      allow update: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch && request.resource.data.branch == request.auth.token.branch);
      allow delete: if isAdmin();
    }

    match /hotels/{docId} {
      allow read: if isAdmin() || isBranchUser();
      allow create, update, delete: if isAdmin();
    }

    match /rooms/{docId} {
      allow read: if isAdmin() || isBranchUser();
      allow create, update, delete: if isAdmin();
    }

    match /clients/{docId} {
      allow read: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch);
      allow create: if isAdmin() || (isBranchUser() && request.resource.data.branch == request.auth.token.branch);
      allow update: if isAdmin() || (isBranchUser() && resource.data.branch == request.auth.token.branch && request.resource.data.branch == request.auth.token.branch);
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}